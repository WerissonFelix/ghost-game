// File name: projects/09/Square/Square.jack


class Ghost {
   /** Implementa um fantasma na tela.*/
   
   field int x, y; // Localizacao do fantasma (em pixels)
   field int size; // Tamanho do fantasma (em pixels)
   field int memAddress;

   /** Constrói um novo fantasma com uma determinada localização e tamanho. */
   constructor Ghost new(int Ax, int Ay) {
      let x = Ax;
      let y = Ay;
      let size = 16;
      let memAddress = 0;
      do draw();
      return this;
   }

   /** Faz o dispose do fantasma na memória. */
   method void dispose() {
      do Memory.deAlloc(this);
      return;
   }

   method int getX() {
      return x;
   }

   method int getY() {
      return y;
   }

   method int getSize() {
      return size;
   }

   /*
   Apaga o Ghost da tela para atualizar seu X e Y 
   e desenhar novamente em sua nova posição 
   */
   method void setPosition(int newX, int newY) {
      do erase();
      let x = newX;
      let y = newY;
      do draw();
      return;
   }

   /** Desenha o fantasma na tela. */
   method void draw() {
      do drawHappyGhost(y * 32 + (x/size));
      return;
   }

   /** Apaga o Ghost da te. */
   method void erase() {
      do Screen.setColor(false);
      do Screen.drawRectangle(x, y, x + size - 1, y + size - 1);
      return;
   }

   /** Desenha um fantasma feliz na tela, na posicao location (0..7679) */
   method void drawHappyGhost(int location) {
      let memAddress = 16384 + location;
      do Memory.poke(memAddress + 0, 8184);
      do Memory.poke(memAddress + 32, 16380);
      do Memory.poke(memAddress + 64, 25542);
      do Memory.poke(memAddress + 96, -1);
      do Memory.poke(memAddress + 128, -2065);
      do Memory.poke(memAddress + 160, -7225);
      do Memory.poke(memAddress + 192, -7225);
      do Memory.poke(memAddress + 224, -2065);
      do Memory.poke(memAddress + 256, -1);
      do Memory.poke(memAddress + 288, -1);
      do Memory.poke(memAddress + 320, -1);
      do Memory.poke(memAddress + 352, -4081);
      do Memory.poke(memAddress + 384, -2017);
      do Memory.poke(memAddress + 416, -961);
      do Memory.poke(memAddress + 448, -1);
      do Memory.poke(memAddress + 480, -1);
      return;
   }

   /** Movimenta o fantasma para cima por 16 pixels. */
   method void moveUp() {
      if (y > 47) {
         do erase();
         let y = y - 16;
         do draw();
      }
      return;
   }

   /** Movimenta o fantasma para baixo por 16 pixels. */
   method void moveDown() {
      if ((y + size) < 240) {
         do erase();
         let y = y + 16;
         do draw();
      }
      return;
   }

   /** Movimenta o fantasma para a esquerda por 16 pixels. */
   method void moveLeft() {
      if (x > 31) {
         do erase();
         let x = x - 16;
         do draw();
      }
      return;
   }

   /** Movimenta o fantasma para a direita por 16 pixels. */
   method void moveRight() {
      if ((x + size) < 496) {
         do erase();
         let x = x + 16;
         do draw();
      }
      return;
   }
}
