class HumanGame {
   field int direction; // the square's current direction: 
                        // 0=none, 1=up, 2=down, 3=left, 4=right
   field Random random;
   field Human human;

   /** Cria um humano e inicializa o estado. */
   constructor HumanGame new(int Ax, int Ay) {
      let human = Human.new(Ax, Ay);
      let random = Random.new(19);
      let direction = 0;  // initial state is no movement
      return this;
   }

   /** Descarta o humano e libera a memória. */
   method void dispose() {
      do human.dispose();
      do random.dispose();
      do Memory.deAlloc(this);
      return;
   }

   /** Move o humano para uma determinada direção. */
   method void moveHuman() {
      if (direction = 1) { do human.moveUp(); }
      if (direction = 2) { do human.moveDown(); }
      if (direction = 3) { do human.moveLeft(); }
      if (direction = 4) { do human.moveRight(); }
      
      return;
   }
   method int getDirection() {
      return direction;
   }
   
   method int getX() {
      return human.getX();
   }

   method int getY() {
      return human.getY();
   }

   method int getSize() {
      return human.getSize();
   }

   /** Atualiza a posição X e Ydo humano. */
   method void setPosition(int newX, int newY) {
      do human.setPosition(newX, newY);
      return;
   }

   /** Move o humano para uma determinada direção. */
   method void setDirection(int new_direction){
      let direction = new_direction;

      return;
   }
}
