/** Implements a graphical square. */
class Human {

   field int x, y; // screen location of the square's top-left corner
   field int size; // length of this square, in pixels
   field int memAddress;

   /** Constructs a new square with a given location and size. */
   constructor Human new(int Ax, int Ay) {
      let x = Ax;
      let y = Ay;
      let size = 16;
      let memAddress = 0;
      do draw();
      return this;
   }

   /** Disposes this square. */
   method void dispose() {
      do Memory.deAlloc(this);
      return;
   }

   method int getX() {
      return x;
   }

   method int getY() {
      return y;
   }

   method int getSize() {
      return size;
   }

   method void setPosition(int newX, int newY) {
      do erase();
      let x = newX;
      let y = newY;
      do draw();
      return;
   }

   /** Draws the square on the screen. */
  method void draw() {
      do drawHuman(y * 32 + (x/size));
      return;
   }

   /** Erases the square from the screen. */
   method void erase() {
      do Screen.setColor(false);
      do Screen.drawRectangle(x, y, x + size - 1, y + size - 1);
      return;
   }

   method void drawHuman(int location) {
        let memAddress = 16384 + location;
        // column 0
        // column 0
        do Memory.poke(memAddress, 384);
        do Memory.poke(memAddress + 32, 960);
        do Memory.poke(memAddress + 64, 960);
        do Memory.poke(memAddress + 96, 960);
        do Memory.poke(memAddress + 128, 384);
        do Memory.poke(memAddress + 160, 2016);
        do Memory.poke(memAddress + 192, 4080);
        do Memory.poke(memAddress + 224, 7128);
        do Memory.poke(memAddress + 256, 5064);
        do Memory.poke(memAddress + 288, 5064);
        do Memory.poke(memAddress + 320, 7128);
        do Memory.poke(memAddress + 352, 5064);
        do Memory.poke(memAddress + 384, 960);
        do Memory.poke(memAddress + 416, 576);
        do Memory.poke(memAddress + 448, 576);
        do Memory.poke(memAddress + 480, 576);
        return;
    }

   /** Moves the ghost up by 16 pixels. */
   method void moveUp() {
      if (y > 47) {
         do erase();
         let y = y - 16;
         do draw();
      }
      return;
   }

   /** Moves the square down by 16 pixels. */
   method void moveDown() {
      if ((y + size) < 240) {
         do erase();
         let y = y + 16;
         do draw();
      }
      return;
   }

   /** Moves the ghost left by 16 pixels. */
   method void moveLeft() {
      if (x > 31) {
         do erase();
         let x = x - 16;
         do draw();
      }
      return;
   }

   /** Moves the square right by 16 pixels. */
   method void moveRight() {
      if ((x + size) < 496) {
         do erase();
         let x = x + 16;
         do draw();
      }
      return;
   }
}
