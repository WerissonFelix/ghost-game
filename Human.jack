/** Implements a graphical square. */
class Ghost {

   field int x, y; // screen location of the square's top-left corner
   field int size; // length of this square, in pixels
   field int memAddress;

   /** Constructs a new square with a given location and size. */
   constructor Ghost new(int Ax, int Ay) {
      let x = Ax;
      let y = Ay;
      let size = 16;
      let memAddress = 0;
      do draw();
      return this;
   }

   /** Disposes this square. */
   method void dispose() {
      do Memory.deAlloc(this);
      return;
   }

   /** Draws the square on the screen. */
   method void draw() {
      do drawHappyGhost(y*32+(x/size));
      return;
   }

   /** Erases the square from the screen. */
   method void erase() {
      do Screen.setColor(false);
      do Screen.drawRectangle(x, y, x + size, y + size);
      return;
   }

    function void draw(int location) {
        var int memAddress; 
        let memAddress = 16384+location;
        // column 0
        do Memory.poke(memAddress, -32712);
        do Memory.poke(memAddress +32, -18);
        do Memory.poke(memAddress +64, 19);
        do Memory.poke(memAddress +96, 17);
        do Memory.poke(memAddress +128, 12691);
        do Memory.poke(memAddress +160, 12688);
        do Memory.poke(memAddress +192, 16);
        do Memory.poke(memAddress +224, 16);
        do Memory.poke(memAddress +256, 3856);
        do Memory.poke(memAddress +288, 1552);
        do Memory.poke(memAddress +320, -32752);
        do Memory.poke(memAddress +352, -32);
        do Memory.poke(memAddress +384, 7936);
        do Memory.poke(memAddress +416, 7936);
        do Memory.poke(memAddress +448, -2);
        do Memory.poke(memAddress +480, -2);
        do Memory.poke(memAddress +512, 7942);
        do Memory.poke(memAddress +544, 6918);
        do Memory.poke(memAddress +576, 6918);
        do Memory.poke(memAddress +608, 6918);
        do Memory.poke(memAddress +640, 6918);
        do Memory.poke(memAddress +672, 6918);
        do Memory.poke(memAddress +704, 6918);
        do Memory.poke(memAddress +736, 6912);
        // column 1
        do Memory.poke(memAddress +1, 7);
        do Memory.poke(memAddress +33, 4);
        do Memory.poke(memAddress +65, 13);
        do Memory.poke(memAddress +97, 9);
        do Memory.poke(memAddress +129, 9);
        do Memory.poke(memAddress +161, 9);
        do Memory.poke(memAddress +193, 13);
        do Memory.poke(memAddress +225, 1);
        do Memory.poke(memAddress +257, 1);
        do Memory.poke(memAddress +289, 1);
        do Memory.poke(memAddress +449, 31);
        do Memory.poke(memAddress +481, 31);
        do Memory.poke(memAddress +513, 24);
        do Memory.poke(memAddress +545, 24);
        do Memory.poke(memAddress +577, 24);
        do Memory.poke(memAddress +609, 24);
        do Memory.poke(memAddress +641, 24);
        do Memory.poke(memAddress +673, 24);
        do Memory.poke(memAddress +705, 24);
        return;
    }



    /** Increments the square size by 2 pixels. */
   method void incSize() {
      if (((y + size) < 254) & ((x + size) < 510)) {
         do erase();
         let size = size + 2;
         do draw();
      }
      return;
   }

   /** Decrements the square size by 2 pixels. */
   method void decSize() {
      if (size > 2) {
         do erase();
         let size = size - 2;
         do draw();
      }
      return;
   }

   /** Moves the ghost up by 16 pixels. */
   method void moveUp() {
      if (y > 15) {
         do erase();
         let y = y - 16;
         do draw();
      }
      return;
   }

   /** Moves the square down by 16 pixels. */
   method void moveDown() {
      if ((y + size) < 239) {
         do erase();
         let y = y + 16;
         do draw();
      }
      return;
   }

   /** Moves the ghost left by 16 pixels. */
   method void moveLeft() {
      if (x > 15) {
         do erase();
         let x = x - 16;
         do draw();
      }
      return;
   }

   /** Moves the square right by 16 pixels. */
   method void moveRight() {
      if ((x + size) < 495) {
         do erase();
         let x = x + 16;
         do draw();
      }
      return;
   }
}
