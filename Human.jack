class Human {
   /**  Implementa o Human */

   field int x, y; // Localizacao do Human (em pixels).
   field int size; // Tamanho do Human (em pixels).
   field int memAddress;

   /** Cria um novo Human com base nas posições X e Y */
   constructor Human new(int Ax, int Ay) {
      let x = Ax;
      let y = Ay;
      let size = 16;
      let memAddress = 0;
      do draw();
      return this;
   }

   /** Esse método faz o dispose do Human na memória. */
   method void dispose() {
      do Memory.deAlloc(this);
      return;
   }

   method int getX() {
      return x;
   }

   method int getY() {
      return y;
   }

   method int getSize() {
      return size;
   }

   /** 
   Apaga o Human da tela para atualizar seu X e Y 
   e desenhar novamente em sua nova posição
   . */
   method void setPosition(int newX, int newY) {
      do erase();
      let x = newX;
      let y = newY;
      do draw();
      return;
   }

   /** Desenha o Human na tela */
  method void draw() {
      do drawHuman(y * 32 + (x/size));
      return;
   }

   /** Apaga o Human da tela. */
   method void erase() {
      do Screen.setColor(false);
      do Screen.drawRectangle(x, y, x + size - 1, y + size - 1);
      return;
   }

   /** Desenha o sprite do Human direto na memória de vídeo a partir de location. Cada poke escreve uma linha de 16 pixels do sprite
   (+32 palavras = próxima linha) */
   method void drawHuman(int location) {
        let memAddress = 16384 + location;
        do Memory.poke(memAddress, 384);
        do Memory.poke(memAddress + 32, 960);
        do Memory.poke(memAddress + 64, 960);
        do Memory.poke(memAddress + 96, 960);
        do Memory.poke(memAddress + 128, 384);
        do Memory.poke(memAddress + 160, 2016);
        do Memory.poke(memAddress + 192, 4080);
        do Memory.poke(memAddress + 224, 7128);
        do Memory.poke(memAddress + 256, 5064);
        do Memory.poke(memAddress + 288, 5064);
        do Memory.poke(memAddress + 320, 7128);
        do Memory.poke(memAddress + 352, 5064);
        do Memory.poke(memAddress + 384, 960);
        do Memory.poke(memAddress + 416, 576);
        do Memory.poke(memAddress + 448, 576);
        do Memory.poke(memAddress + 480, 576);
        return;
    }

   /** Movimenta o Human para cima por 16 pixels. */
   method void moveUp() {
      if (y > 47) {
         do erase();
         let y = y - 16;
         do draw();
      }
      return;
   }

   /** Movimenta o Human para baixo por 16 pixels. */
   method void moveDown() {
      if ((y + size) < 240) {
         do erase();
         let y = y + 16;
         do draw();
      }
      return;
   }

   /** Movimenta o Human para a esquerda por 16 pixels. */
   method void moveLeft() {
      if (x > 31) {
         do erase();
         let x = x - 16;
         do draw();
      }
      return;
   }

   /** Movimenta o Human para a direita por 16 pixels. */
   method void moveRight() {
      if ((x + size) < 496) {
         do erase();
         let x = x + 16;
         do draw();
      }
      return;
   }
}
