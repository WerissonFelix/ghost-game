/** Implements a graphical square. */
class Human {

   field int x, y; // screen location of the square's top-left corner
   field int size; // length of this square, in pixels
   field int memAddress;

   /** Constructs a new square with a given location and size. */
   constructor Human new(int Ax, int Ay) {
      let x = Ax;
      let y = Ay;
      let size = 16;
      let memAddress = 0;
      do draw();
      return this;
   }

   /** Disposes this square. */
   method void dispose() {
      do Memory.deAlloc(this);
      return;
   }

   /** Draws the square on the screen. */
  method void draw() {
      do drawHuman(y*32+(x/size));
      return;
   }

   /** Erases the square from the screen. */
   method void erase() {
      do Screen.setColor(false);
      do Screen.drawRectangle(x, y + 16, x + size, y + size + 16);
      return;
   }

   method void drawHuman(int location) {
        let memAddress = 16384+location+512;
        // column 0
        // column 0
        do Memory.poke(memAddress, 48);
        do Memory.poke(memAddress +32, 120);
        do Memory.poke(memAddress +64, 120);
        do Memory.poke(memAddress +96, 120);
        do Memory.poke(memAddress +128, 48);
        do Memory.poke(memAddress +160, 252);
        do Memory.poke(memAddress +192, 510);
        do Memory.poke(memAddress +224, 891);
        do Memory.poke(memAddress +256, 633);
        do Memory.poke(memAddress +288, 633);
        do Memory.poke(memAddress +320, 891);
        do Memory.poke(memAddress +352, 633);
        do Memory.poke(memAddress +384, 120);
        do Memory.poke(memAddress +416, 72);
        do Memory.poke(memAddress +448, 72);
        do Memory.poke(memAddress +480, 72);
        return;
    }

   /** Moves the ghost up by 16 pixels. */
   method void moveUp() {
      if (y > 15) {
         do erase();
         let y = y - 16;
         do draw();
      }
      return;
   }

   /** Moves the square down by 16 pixels. */
   method void moveDown() {
      if ((y + size) < 239) {
         do erase();
         let y = y + 16;
         do draw();
      }
      return;
   }

   /** Moves the ghost left by 16 pixels. */
   method void moveLeft() {
      if (x > 15) {
         do erase();
         let x = x - 16;
         do draw();
      }
      return;
   }

   /** Moves the square right by 16 pixels. */
   method void moveRight() {
      if ((x + size) < 495) {
         do erase();
         let x = x + 16;
         do draw();
      }
      return;
   }
}
