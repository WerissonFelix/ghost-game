class GhostGame {
   field int direction; // A direção em que o ghost se desloca: 
                        // 0=none, 1=up, 2=down, 3=left, 4=right
   field Random random;
   field Ghost ghost;

   /** Cria um fantasma e inicializa o estado. */
   constructor GhostGame new(int Ax, int Ay) {
      let ghost = Ghost.new(Ax, Ay);
      let random = Random.new(2);
      let direction = 0;  // Estado inicial é sem movimento
      return this;
   }

   /** Descarta o ghost e libera a memória. */
   method void dispose() {
      do ghost.dispose();
      do random.dispose();
      do Memory.deAlloc(this);
      return;
   }

   /** Move o Ghost para uma determinada direção. */
   method void moveGhost() {
      if (direction = 1) { do ghost.moveUp(); }
      if (direction = 2) { do ghost.moveDown(); }
      if (direction = 3) { do ghost.moveLeft(); }
      if (direction = 4) { do ghost.moveRight(); }
      
      return;
   }

   method int getX() {
      return ghost.getX();
   }

   method int getY() {
      return ghost.getY();
   }

   method int getSize() {
      return ghost.getSize();
   }

   method int getDirection() {
      return direction;
   }
   
   /* Atualiza as posições X e Y */
   method void setPosition(int newX, int newY) {
      do ghost.setPosition(newX, newY);
      return;
   }

   /* Atualiza a direção para onde o ghost se desloca */
   method void setDirection(int new_direction){
      let direction = new_direction;

      return;
   }

   
}
