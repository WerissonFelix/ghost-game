/**
 * Implements the Square Dance game.
 * This simple game allows the user to move a black square around
 * the screen, and change the square's size during the movement.
 * When the game starts, a square of 30 by 30 pixels is shown at the
 * top-left corner of the screen. The user controls the square as follows.
 * The 4 arrow keys are used to move the square up, down, left, and right.
 * The 'z' and 'x' keys are used, respectively, to decrement and increment
 * the square's size. The 'q' key is used to quit the game.
 */

class GhostGame {
   field int direction; // the square's current direction: 
                        // 0=none, 1=up, 2=down, 3=left, 4=right
   field Random random;
   field Ghost ghost;

   /** Constructs a new Square Game. */
   constructor GhostGame new(int Ax, int Ay) {
      let ghost = Ghost.new(Ax, Ay);
      let random = Random.new(2);
      let direction = 0;  // initial state is no movement
      return this;
   }

   /** Disposes this game. */
   method void dispose() {
      do ghost.dispose();
      do Memory.deAlloc(this);
      return;
   }

   /** Moves the square in the current direction. */
   method void moveGhost() {
      if (direction = 1) { do ghost.moveUp(); }
      if (direction = 2) { do ghost.moveDown(); }
      if (direction = 3) { do ghost.moveLeft(); }
      if (direction = 4) { do ghost.moveRight(); }
      
      return;
   }

   method int getX() {
      return ghost.getX();
   }

   method int getY() {
      return ghost.getY();
   }

   method int getSize() {
      return ghost.getSize();
   }

   method int getDirection() {
      return direction;
   }

   method void setPosition(int newX, int newY) {
      do ghost.setPosition(newX, newY);
      return;
   }

   method void setDirection(int new_direction){
      let direction = new_direction;

      return;
   }

   
}
