class GameManager{

    field int level;
    field int ghostDirection;
    field int humanDirection;
    field int cycleCounter;
    field GhostGame ghost;
    field HumanGame human;
    field Random random;
    field GameMap map;
    field Timer humanTimer, ghostTimer;
    
    

    constructor GameManager new() {
        let level = 0;
        let ghostDirection = 0;
        let humanDirection = 0;
        let cycleCounter = 0;

        let random = Random.new(20);
        let map = GameMap.new();
        let humanTimer = Timer.new(3);
        let ghostTimer = Timer.new(7);

        return this;
    }

    method void dispose(){
        if (~(ghost = 0)) {
            do ghost.dispose();
        }
        if (~(human = 0)) {
            do human.dispose();
        }
        do map.dispose();
        do Memory.deAlloc(this);

        return;
    }

    method boolean playersCollided() {
        var int ghostX, ghostY, ghostSize;
        var int humanX, humanY, humanSize;
        var boolean xTouch, yTouch;

        let ghostX = ghost.getX();
        let ghostY = ghost.getY();
        let ghostSize = ghost.getSize();
        let humanX = human.getX();
        let humanY = human.getY();
        let humanSize = human.getSize();

        if ((ghostX + ghostSize) < humanX) { return false; }
        if ((humanX + humanSize) < ghostX) { return false; }
        if ((ghostY + ghostSize) < humanY) { return false; }
        if ((humanY + humanSize) < ghostY) { return false; }

        let xTouch = ((ghostX + ghostSize) = humanX) | ((humanX + humanSize) = ghostX);
        let yTouch = ((ghostY + ghostSize) = humanY) | ((humanY + humanSize) = ghostY);
        if (xTouch & yTouch) { 
            return false; 
            
            }

        return true;
    }

    method void run() {
        var char key;  // the key currently pressed by the user
        var boolean exit;
        var int count;

        do Screen.clearScreen();
        do Output.moveCursor(5, 23);
        do Output.printString("GHOST MULTIPLAYER");
        do Output.moveCursor(8, 10);
        do Output.printString("Jogador 1 (Fantasma): setas = direcao, . = parar");
        do Output.moveCursor(10, 10);
        do Output.printString("Jogador 2 (Pessoa): W A S D = direcao, E = parar");
        do Output.moveCursor(12, 10);
        do Output.printString("ESC = sair");
        do Output.moveCursor(15, 17);
        do Output.printString("Pressione ENTER para comecar");

        let key = 0;
        let count = 0;
        while (~(key = 128) & ~(key = 140)) {   // 128 = ENTER, 140 = ESC
            let key = Keyboard.keyPressed();
            let count = count + 1;
        }
        do random.setSeed(count);
        while (~(Keyboard.keyPressed() = 0)) {}  // espera soltar a tecla
        if (key = 140) {
            return;
        }

        do Screen.clearScreen();
        do startRound();
        let exit = false;
        

        do Output.moveCursor(0, 0);
        do Output.printString("HUMAN: ");
        do humanTimer.printTime(0, 7);

        do Output.moveCursor(0, 56);
        do Output.printString("GHOST: ");
        do ghostTimer.printTime(0, 63);
        
        while (~exit) {
            // waits for a key to be pressed
            let key = Keyboard.keyPressed();

            // Ghost Direction
            if (key = 81)  { let exit = true; }            // q key
            if (key = 46)  { do ghost.setDirection(0); }   // . - Idle
            if (key = 131) { do ghost.setDirection(1); }   // up arrow
            if (key = 133) { do ghost.setDirection(2); }   // down arrow
            if (key = 130) { do ghost.setDirection(3); }   // left arrow
            if (key = 132) { do ghost.setDirection(4); }   // right arrow

            // Human Direction
            if (key = 81)  { let exit = true; }            // q key
            if (key = 101) { do human.setDirection(0); }   // E - Idle
            if (key = 119) { do human.setDirection(1); }   // W - up
            if (key = 115) { do human.setDirection(2); }   // S - down
            if (key = 97)  { do human.setDirection(3); }   // A - left
            if (key = 100) { do human.setDirection(4); }   // D - right

            if (map.canMove(ghost.getX() / 16, ghost.getY() / 16, ghost.getDirection())) {
                do ghost.moveGhost();
            }
            
            if (map.canMove(human.getX() / 16, human.getY() / 16, human.getDirection())) {
                do human.moveHuman();
            }

            if (playersCollided()) {
                let exit = true;
            }

            let cycleCounter = cycleCounter + 1;


            if (cycleCounter > 19){
                if (~(humanTimer.isFinished())) {
                    do humanTimer.decrement();
                    do humanTimer.printTime(0, 7);

                }
                else{
                    if (~(ghostTimer.isFinished())){
                        do ghostTimer.decrement();
                        do ghostTimer.printTime(0, 32);

                    }

                    if (ghostTimer.isFinished()){
                        let exit = true;
                    }
                }
                
                let cycleCounter = 0;
            }

            do Sys.wait(50);
            
        }
        return;
    }

    method void startRound() {
        var int ghostColumn, ghostRow, humanColumn, humanRow;

        do map.load(level);
        do map.draw();
        if (level = 2) {
            let level = 0;
        } else {
            let level = level + 1;
        }

        // random position for the ghost, not a wall
        let ghostColumn = random.randRange(31);
        let ghostRow = 1 + random.randRange(14);
        while (map.isWall(ghostColumn, ghostRow)) {
            let ghostColumn = random.randRange(31);
            let ghostRow = 1 + random.randRange(14);
        }

        // random position for the human, not a wall and not the same as the ghost
        let humanColumn = random.randRange(31);
        let humanRow = 1 + random.randRange(14);
        while (map.isWall(humanColumn, humanRow) | ((humanColumn = ghostColumn) & (humanRow = ghostRow))) {
            let humanColumn = random.randRange(31);
            let humanRow = 1 + random.randRange(14);
        }

        let ghost = GhostGame.new(ghostColumn * 16, ghostRow * 16);

        //do ghost.setPosition();
        let human = HumanGame.new(humanColumn * 16, humanRow * 16);
        //do human.setPosition();
        return;
    }
}