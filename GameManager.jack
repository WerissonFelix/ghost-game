/** Gerencia o jogo, lógica de pontuação, mapa, colisões, etc. */
class GameManager{
    field int level;
    field int cycleCounter;
    field boolean canGhostMove;
    field int ghostPoints, humanPoints;
    field GhostGame ghost;
    field HumanGame human;
    field Random random;
    field GameMap map;
    field Timer humanTimer, ghostTimer;

    /** Cria o gerenciador do jogo e inicializa o estado */
    constructor GameManager new() {
        let level = 0;
        let cycleCounter = 0;
        let ghostPoints = 0;
        let humanPoints = 0;
        let canGhostMove = false;

        let random = Random.new(20);
        let map = GameMap.new();
        let humanTimer = Timer.new(3);
        let ghostTimer = Timer.new(7);

        return this;
    }

    /** Descarta o gerenciador do jogo e libera a memória */
    method void dispose(){
        if (~(ghost = 0)) {
            do ghost.dispose();
            let ghost = 0;
        }
        if (~(human = 0)) {
            do human.dispose();
            let human = 0;
        }
        do map.dispose();
        let map = 0;
        do random.dispose();
        let random = 0;
        do humanTimer.dispose();
        let humanTimer = 0;
        do ghostTimer.dispose();
        let ghostTimer = 0;
        do Memory.deAlloc(this);

        return;
    }

    /** Descarta o humano e o fantasma da rodada atual */
    method void disposeRound() {
        if (~(ghost = 0)) {
            do ghost.dispose();
            let ghost = 0;
        }
        if (~(human = 0)) {
            do human.dispose();
            let human = 0;
        }
        return;
    }

    /** Verifica se o fantasma e o humano colidiram */
    method boolean playersCollided() {
        var int ghostX, ghostY, ghostSize;
        var int humanX, humanY, humanSize;
        var boolean xTouch, yTouch;

        let ghostX = ghost.getX();
        let ghostY = ghost.getY();
        let ghostSize = ghost.getSize();
        let humanX = human.getX();
        let humanY = human.getY();
        let humanSize = human.getSize();

        // Verifica se existe separação entre as hitboxes
        if ((ghostX + ghostSize) < humanX) { return false; }
        if ((humanX + humanSize) < ghostX) { return false; }
        if ((ghostY + ghostSize) < humanY) { return false; }
        if ((humanY + humanSize) < ghostY) { return false; }
     
        // Identifica se as hitboxes apenas se tocam pelas bordas.    
        let xTouch = ((ghostX + ghostSize) = humanX) | ((humanX + humanSize) = ghostX);
        let yTouch = ((ghostY + ghostSize) = humanY) | ((humanY + humanSize) = ghostY);
        if (xTouch & yTouch) { 
            return false; 
            
            }

        return true;
    }

    /** Inicia uma nova rodada do jogo, criando um novo fantasma e humano em posições aleatórias no mapa */
    method void startRound() {
        var int ghostColumn, ghostRow, humanColumn, humanRow;

        do map.load(level);
        do map.draw();
        if (level = 2) {
            do map.setLevel(0);
            let level = 0;
        } else {
            let level = level + 1;
        }

        // Gera uma posição aleatória para o Ghost, evita que seja um obstáculo
        let ghostColumn = random.randRange(31);
        let ghostRow = 1 + random.randRange(14);
        while (map.isWall(ghostColumn, ghostRow)) {
            let ghostColumn = random.randRange(31);
            let ghostRow = 1 + random.randRange(14);
        }

        /*
        Gera uma posição aleatória para o Human, evita que seja um obstáculo
        e que seja a mesma posição do Ghost*/
        let humanColumn = random.randRange(31);
        let humanRow = 1 + random.randRange(14);
        while (map.isWall(humanColumn, humanRow) | ((humanColumn = ghostColumn) & (humanRow = ghostRow))) {
            let humanColumn = random.randRange(31);
            let humanRow = 1 + random.randRange(14);
        }

        let ghost = GhostGame.new(ghostColumn * 16, ghostRow * 16);   
        let human = HumanGame.new(humanColumn * 16, humanRow * 16);

        let canGhostMove = false;
        do humanTimer.setTime(3);
        do ghostTimer.setTime(7);
                
        return;
    }

    /**
    Prepara o jogo para ser executado, exibindo instruções e esperando o usuário pressionar uma tecla.

    Utiliza o tempo de espera de apertar a tecla como semente para o gerador de números aleatórios. 
    */
    method boolean prepareToRun(){
        var char key;  // A tecla que está sendo pressionada pelo user
        var int count;

        do Screen.clearScreen();
        do Output.moveCursor(5, 23);
        do Output.printString("GHOST MULTIPLAYER");
        do Output.moveCursor(8, 10);
        do Output.printString("Jogador 1 (Fantasma): setas = direcao, . = parar");
        do Output.moveCursor(10, 10);
        do Output.printString("Jogador 2 (Pessoa): W A S D = direcao, E = parar");
        do Output.moveCursor(12, 10);
        do Output.printString("ESC = sair");
        do Output.moveCursor(15, 17);
        do Output.printString("Pressione ENTER para comecar");

        let key = 0;
        let count = 0;
        while (~(key = 128) & ~(key = 140)) {   // 128 = ENTER, 140 = ESC
            let key = Keyboard.keyPressed();
            let count = count + 1;
        }
        do random.setSeed(count);
        while (~(Keyboard.keyPressed() = 0)) {}  // espera soltar a tecla
        if (key = 140) {
            return false;
        }

        do Screen.clearScreen();
        do startRound();
        
        // Printa os Timers do Human e do Ghost
        do Output.moveCursor(0, 0);
        do Output.printString("HUMAN: ");
        do humanTimer.printTime(0, 7);

        do Output.moveCursor(0, 56);
        do Output.printString("GHOST: ");
        do ghostTimer.printTime(0, 63);
        do printPoints();
        
        return true;
    }

    /**
    Exibe a mensagem final do jogo, mostrando os pontos de cada jogador e 
    aguardando o usuário pressionar ENTER para continuar ou ESC para sair. */
    method boolean finalMensage(){
        var char key;
        do Output.moveCursor(9, 12);
        do Output.printString("Human Points: ");
        do Output.printInt(humanPoints);

        do Output.moveCursor(9, 36);
        do Output.printString("Ghost Points: ");
        do Output.printInt(ghostPoints);
        
        do Output.moveCursor(12, 9);
        do Output.printString("Press ENTER to continue or press ESC to exit...");
        let key = 0;
        while (~(key = 128) & ~(key = 140)) {
            let key = Keyboard.keyPressed();
        }
       

        if (key = 128) {
            return true;
        }
        return false;
    }

    /** Imprime os pontos atuais de cada jogador na tela. */
    method void printPoints(){
        do Output.moveCursor(0, 18);
        do Output.printString("HUMAN ");
        do Output.printInt(humanPoints);

        do Output.moveCursor(0, 38);
        do Output.printString("GHOST ");
        do Output.printInt(ghostPoints);

        return;
    }

    /**
    Executa o loop principal do jogo, processando entradas do usuário,
    movimentando os jogadores e verificando colisões. */
    method void run() {
        var char key;  // A tecla que está sendo pressionada pelo user
        var boolean exit;

        if (~prepareToRun()) {
            return;
        }
        let exit = false;

        while (~exit) {
            let key = Keyboard.keyPressed();

            // Controles do Ghost
            if (canGhostMove){
                if (key = 140)  { let exit = true; }            // ESC key
                if (key = 46)   { do ghost.setDirection(0); }   // . - Idle
                if (key = 131)  { do ghost.setDirection(1); }   // up arrow
                if (key = 133)  { do ghost.setDirection(2); }   // down arrow
                if (key = 130)  { do ghost.setDirection(3); }   // left arrow
                if (key = 132)  { do ghost.setDirection(4); }   // right arrow
            }
            
            // Controles do Human
            if (key = 140)  { let exit = true; }            // ESC key
            if (key = 101)  { do human.setDirection(0); }   // E - Idle
            if (key = 119)  { do human.setDirection(1); }   // W - up
            if (key = 115)  { do human.setDirection(2); }   // S - down
            if (key = 97)   { do human.setDirection(3); }   // A - left
            if (key = 100)  { do human.setDirection(4); }   // D - right

            if (map.canMove(ghost.getX() / 16, ghost.getY() / 16, ghost.getDirection())) {
                do ghost.moveGhost();
            }
            
            if (map.canMove(human.getX() / 16, human.getY() / 16, human.getDirection())) {
                do human.moveHuman();
            }

            /** Verifica se o fantasma e o humano colidiram, atualiza os pontos e exibe a mensagem de fim de jogo se necessário. */
            if (playersCollided()) {
                let ghostPoints = ghostPoints + 1;
                do Screen.clearScreen();
                do Output.moveCursor(11, 21);
                do Output.printString("GAME OVER, GHOST WINS");
                if (finalMensage()) {
                    do disposeRound();
                    do startRound();
                    let cycleCounter = 0;
                    let canGhostMove = false;
                    do Output.moveCursor(0, 0);
                    do Output.printString("HUMAN: ");
                    do humanTimer.printTime(0, 7);
                    do Output.moveCursor(0, 56);
                    do Output.printString("GHOST: ");
                    do ghostTimer.printTime(0, 63);
                    do printPoints();
                } else {
                    do disposeRound();
                    let exit = true;
                }
            }

            let cycleCounter = cycleCounter + 1;

            if (cycleCounter > 19){ // 20 ciclos de 50 ms correspondem a aproximadamente 1 segundo
                if (~(humanTimer.isFinished())) {
                    /* 
                    Decrementa 1 segundo enquanto o humanTimer não chegar a zero.
                    o Ghost não pode se mover enquanto o humanTimer for maior que 
                    zero.
                    */
                    do humanTimer.decrement();
                    do humanTimer.printTime(0, 7); 

                }
                else{
                    let canGhostMove = true;

                    if (~(ghostTimer.isFinished())){
                        // Decrementa 1 segundo enquanto o ghostTimer não chegar a zero
                        do ghostTimer.decrement();
                        do ghostTimer.printTime(0, 63);
                    }

                    if (ghostTimer.isFinished()){
                        /* 
                        Se o ghostTimer chegar a zero, significa que o tempo de 'caça' acabou
                        e o human não foi pego, logo, vitória para o human
                        */
                        let humanPoints = humanPoints + 1;
                        do Screen.clearScreen();
                        do Output.moveCursor(11, 21);
                        do Output.printString("GAME OVER, HUMAN WINS");
                        if (finalMensage()) {
                            // Termina o round e prepara para o próximo
                            do disposeRound();
                            do startRound();
                            let cycleCounter = 0;
                            let canGhostMove = false;
                            do Output.moveCursor(0, 0);
                            do Output.printString("HUMAN: ");
                            do humanTimer.printTime(0, 7);
                            do Output.moveCursor(0, 56);
                            do Output.printString("GHOST: ");
                            do ghostTimer.printTime(0, 63);
                            do printPoints();
                        } else {
                            do disposeRound();
                            let exit = true;
                        }
                    }
                }
                
                let cycleCounter = 0;
            }

            do Sys.wait(50);

        }
        return;
    }  
}