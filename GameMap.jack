// Guarda o mapa do jogo e soluciona as colisoes com paredes.
// A tela do Hack tem 512 x 256 pixels. Cada sprite tem 16 x 16 pixels,
// o mapa e uma grade de 32 colunas x 16 linhas (cada celula = 1 sprite).
//   - Linha 0  : reservada para o placar e os relogios (HUD). Nunca e andavel.
//   - Linhas 1..15 : labirinto.
// Representacao: cada linha da grade ocupa 2 palavras de 16 bits
// (palavra 0 = colunas 0..15, palavra 1 = colunas 16..31).
// Bit = 1 significa PAREDE; o bit i da palavra corresponde a coluna i.
// Isso gasta apenas 32 palavras de memória por mapa.
// Existem 3 mapas fixos (0, 1 e 2). O jogo troca de mapa a cada reinicio.

class GameMap {
   field Array grid;    // 16 linhas x 2 palavras
   field Array twoPow;  // twoPow[i] = 2^i (mascara do bit i)
   field int level;     // mapa carregado atualmente (0, 1 ou 2)

   /** Cria o mapa vazio e prepara a tabela de potências de 2. */
   constructor GameMap new() {
      var int bitIndex, powerOfTwo;
      let grid = Array.new(32);
      let twoPow = Array.new(16);
      let level = 0;
      let bitIndex = 0;
      let powerOfTwo = 1;
      while (bitIndex < 16) {
         let twoPow[bitIndex] = powerOfTwo;
         let powerOfTwo = powerOfTwo + powerOfTwo;
         let bitIndex = bitIndex + 1;
      }
      return this;
   }

   /** Libera a memória do mapa. */
   method void dispose() {
      do grid.dispose();
      do twoPow.dispose();
      do Memory.deAlloc(this);
      return;
   }

   /** Define as duas palavras de uma linha. */
   method void setRow(int row, int leftWord, int rightWord) {
      let grid[row * 2] = leftWord;
      let grid[(row * 2) + 1] = rightWord;
      return;
   }

   /** Retorna true se a célula (col, row) e parede ou está fora da tela. */
   method boolean isWall(int col, int row) {
      var int wallMask, bitIndex;
      if ((col < 0) | (col > 31) | (row < 0) | (row > 15)) {
         return true;
      }
      let wallMask = grid[(row * 2) + (col / 16)];
      let bitIndex = col & 15;                // coluna dentro da palavra
      return ~((wallMask & twoPow[bitIndex]) = 0);
   }

   /** Retorna true se quem esta em (col, row) consegue dar um passo na
   direcao dir sem bater em parede.
   dir: 1 = cima, 2 = baixo, 3 = esquerda, 4 = direita.
   Retorna false se (col, row) estiver fora da tela ou dir = 0. */
   method boolean canMove(int col, int row, int dir) {
      if (dir = 1) { return ~isWall(col, row - 1); }
      if (dir = 2) { return ~isWall(col, row + 1); }
      if (dir = 3) { return ~isWall(col - 1, row); }
      if (dir = 4) { return ~isWall(col + 1, row); }
      return false;
   }

   /** Define o mapa atual (0, 1 ou 2). */
   method void setLevel(int newLevel){
      let level = newLevel;

      return;
   }

   /** Carrega o mapa de numero n (0, 1 ou 2). */
   method void load(int n) {
      let level = n;
      do setRow(0, -1, -1);   // A linha 0 = HUD, não é andavel!
      if (n = 0) { do loadMap0(); }
      if (n = 1) { do loadMap1(); }
      if (n = 2) { do loadMap2(); }
      return;
   }

   /** Limpa a tela e desenha todas as paredes (linhas 1..15). */
   method void draw() {
      var int row, col;
      do Screen.clearScreen();
      let row = 1;
      while (row < 16) {
         let col = 0;
         while (col < 32) {
            if (isWall(col, row)) { do drawWall(col, row); }
            let col = col + 1;
         }
         let row = row + 1;
      }
      return;
   }

   /** Desenha um bloco de parede 16x16 (16 palavras de 16 bits). */
   method void drawWall(int col, int row) {
      var int address, pixelRow;
      let address = 16384 + (row * 512) + col;
      let pixelRow = 0;
      while (pixelRow < 16) {
         do Memory.poke(address, -1);
         let address = address + 32;
         let pixelRow = pixelRow + 1;
      }
      return;
   }

   /** Mapa 0 - corredores */
   method void loadMap0() {
      do setRow(1, -1, -1);
      do setRow(2, 257, -32640);
      do setRow(3, 32125, -16706);
      do setRow(4, 5, -24576);
      do setRow(5, 32629, -20738);
      do setRow(6, 1041, -30688);
      do setRow(7, 30167, -5202);
      do setRow(8, 4177, -30200);
      do setRow(9, -10409, -5397);
      do setRow(10, 1089, -32224);
      do setRow(11, 30077, -16722);
      do setRow(12, 4357, -24440);
      do setRow(13, 24565, -20486);
      do setRow(14, 1, -32767-1);
      do setRow(15, -1, -1);
      return;
   }

   /** Mapa 1 - salas e pilares */
   method void loadMap1() {
      do setRow(1, -1, -1);
      do setRow(2, 1, -32767-1);
      do setRow(3, 31725, -18466);
      do setRow(4, 16429, -19454);
      do setRow(5, 24481, -31238);
      do setRow(6, 16559, -2814);
      do setRow(7, 7841, -31368);
      do setRow(8, 701, -17088);
      do setRow(9, 31361, -32418);
      do setRow(10, 2813, -16560);
      do setRow(11, 27141, -24490);
      do setRow(12, 11253, -20524);
      do setRow(13, -30715, -24559);
      do setRow(14, -32767, -32767);
      do setRow(15, -1, -1);
      return;
   }

   /** Mapa 2 - arena com blocos */
    method void loadMap2() {
        do setRow(1, -1, -1);
        do setRow(2, 1, -32767-1);
        do setRow(3, 24285, -17542);
        do setRow(4, 16581, -23806);
        do setRow(5, 24277, -21638);
        do setRow(6, 8209, -30716);
        do setRow(7, -20521, -5131);
        do setRow(8, 81, -30208);
        do setRow(9, -16553, -5379);
        do setRow(10, 273, -30592);
        do setRow(11, 32245, -20546);
        do setRow(12, 5, -24576);
        do setRow(13, 24437, -20742);
        do setRow(14, 1, -32767-1);
        do setRow(15, -1, -1);
        return;
    }
}
